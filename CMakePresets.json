{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "binaryDir": "build",
            "cacheVariables": {
                "SOLVER_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "iwyu",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_INCLUDE_WHAT_YOU_USE": "include-what-you-use"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "base",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "base",
            "configuration": "Release"
        }
    ]
}
